# ============================================================
# .env.example — copy this file to `.env` and fill in your keys
#   cp .env.example .env
# The real .env is gitignored and must NEVER be committed.
# ============================================================

# --- LLM provider API keys (get from each provider's console) ---
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
CEREBRAS_API_KEY=your-cerebras-api-key-here
NVIDIA_API_KEY=your-nvidia-api-key-here

# --- Web search (https://tavily.com) ---
TAVILY_API_KEY=your-tavily-api-key-here

# --- GitHub Models access token ---
GITHUB_ACCESS_TOKEN=your-github-access-token-here

# --- Gateway config (defaults usually fine) ---
LLM_GATEWAY_V7_URL=http://localhost:8107
GATEWAY_V7_PORT=8107
LLM_ORDER=gemini,groq,cerebras,github

# --- Embeddings (Ollama local, Gemini fallback) ---
OLLAMA_URL=http://localhost:11434
EMBED_OLLAMA_MODEL=nomic-embed-text
EMBED_FALLBACK_PROVIDER=gemini
EMBED_FALLBACK_MODEL=gemini-embedding-001
EMBED_ORDER=ollama,gemini
